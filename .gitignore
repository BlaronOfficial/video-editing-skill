# Per-user data: brand kits, style profiles, learned preferences, CapCut calibration,
# asset index, API keys. `git pull` never touches this folder.
/personal/

# Downloaded fonts, models, renderer caches
/.cache/

# Secrets: API keys go in environment variables or personal/secrets.json, never in tracked files
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
# Remotion installs on first use, so its lockfile is made on each machine
/mg/remotion/package-lock.json

# OS / editor
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Claude Code's per-machine permissions, made when it runs inside the skill folder
/.claude/settings.local.json

# Test footage and renders made while developing the skill
/tests/footage/
/tests/out/

# Claude-app launcher zips are built per machine (they carry the local skill path)
/app/claude-app/*.zip

# Animated pieces built in place (pieces normally live in a project's edit/anim/)
/anim/**/index.html
/anim/**/renders/
/anim/**/review/
